# Copie para profiles.yml nesta pasta (esse arquivo não entra no Git):
#   cp profiles.yml.example profiles.yml
# Rode a partir de dbt/:
#   dbt parse --profiles-dir .
farmadata:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5432
      user: postgres
      password: "{{ env_var('POSTGRES_PASSWORD', 'postgres') }}"
      dbname: farmadata
      schema: dbt
      threads: 4
